# Скопируйте в .env и при необходимости поменяйте. Без .env используются dev-значения из docker-compose.yml.
POSTGRES_PASSWORD=janamen_dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1

# --- Интеграции (ARCHITECTURE.md §7) ---
# 1С:ЗУП: zup_http — заглушка mock-zup или боевой HTTP-сервис ЗУП; inmemory — без сети; none — выключено
HRIS_PROVIDER=zup_http
ZUP_BASE_URL=http://mock-zup:8001
ZUP_USER=janamen
ZUP_PASSWORD=zup_dev

# Documentolog: documentolog_http — заглушка mock-documentolog или боевой API; inmemory; none
DOCFLOW_PROVIDER=documentolog_http
DOCUMENTOLOG_BASE_URL=http://mock-documentolog:8002
DOCUMENTOLOG_TOKEN=docflow_dev
# Секрет подписи обратных вызовов (одинаковый у backend и Documentolog)
DOCUMENTOLOG_WEBHOOK_SECRET=dev-webhook-secret
# Через сколько секунд заглушка «подписывает» приказ
DOCUMENTOLOG_SIGN_DELAY=10

# Сколько раз worker пытается доставить задачу во внешнюю систему
# OUTBOX_MAX_ATTEMPTS=8

# --- AI Jana (следующий этап) ---
# ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-5-5
# AI_MIN_SCORE=
